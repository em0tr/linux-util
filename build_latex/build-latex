#!/bin/bash

compile() {
    if ! ls *.tex > /dev/null 2>&1; then
        echo "There are no LaTeX files in the directory. Exiting..."
        return 1
    fi

    if [[ ! -f "$(pwd)/main.tex" ]]; then
        echo "No 'main.tex' file found. Makefile requires a 'main.tex' file. Exiting..."
        return 1
    fi

    local make_args=()
    [[ -n "$ENGINE_FLAG" ]] && make_args+=("LATEXMK_ENGINE_FLAG=${ENGINE_FLAG}")
    [[ -n "$OUTPUT_NAME" ]] && make_args+=("JOBNAME=${OUTPUT_NAME}")

    make -f ~/linux-util/build_latex/Makefile -C "$(pwd)" --no-print-directory "${make_args[@]}"

    echo "Makefile completed"
}

view() {
    local name="${OUTPUT_NAME:-main}"
    local pdf="$(pwd)/${name}.pdf"

    if [[ ! -f "$pdf" ]]; then
        echo "No '${name}.pdf' file found in $(pwd). Exiting..."
        return 1
    fi

    if command -v evince &> /dev/null; then
        evince "$pdf"
    else
        echo "No PDF viewer available. If on a VPS run this on your local machine:"
        printf 'scp %q %q\n' "user@your-vps:$pdf" "./${name}.pdf"
    fi
}

init() {
    if [[ -f "$(pwd)/main.tex" ]]; then
        echo "Directory has been initialized with LaTeX already"
        return 1
    fi
    cp ~/linux-util/build_latex/template.tex $(pwd)/main.tex
    cp ~/linux-util/build_latex/template.bib $(pwd)/main.bib
    mkdir -p $(pwd)/figures
}

help() {
    echo "Build LaTeX files and view PDF files."
    echo ""
    echo "Usage:    build-latex {compile|view|clean|init}"
    echo "compile - build-latex compile [--engine=pdflatex|lualatex]"
    echo "view    - View the PDF file with Evince"
    echo "clean   - Clean the directory by removing many of the output files (main.log, main.run.xml etc)"
    echo "init    - Initialize a new LaTeX project and create a project using a template"
    echo "none    - No operation"
    return 0
}

OPERATION=${1:-None} # If no argument is provided, default to None
OPERATION=$(echo "$OPERATION" | tr '[:upper:]' '[:lower:]') # Convert input to lowercase

ENGINE_FLAG=""
NAME=""

for arg in "${@:2}"; do
    case "$arg" in
        --engine=*)
            case "${arg#--engine=}" in
                pdflatex) ENGINE_FLAG="-pdf" ;;
                lualatex) ENGINE_FLAG="-lualatex" ;;
                *)
                    echo "Invalid --engine value: ${arg#--engine=}"
                    echo "Valid: pdflatex, lualatex"
                    return 1
                ;;
            esac
        ;;
        --name=*)
            OUTPUT_NAME="${arg#--name=}"
            OUTPUT_NAME="${OUTPUT_NAME%.pdf}"   # allow --name=report.pdf too
            if [[ ! "$OUTPUT_NAME" =~ ^[A-Za-z0-9._-]+$ ]]; then
                echo "Invalid --name value. Use only letters, digits, '.', '_' and '-'."
                return 1
            fi
        ;;
        *)
            echo "Unknown option: $arg"
            return 1
        ;;
    esac
done

case $OPERATION in
    compile|build)
        echo "Running Makefile for compiling LaTeX files"
        compile
    ;;
    view)
        echo "Viewing main.pdf file in directory"
        view
    ;;
    help|h)
        help
    ;;
    clean)
        echo "Clean LaTeX build files"
        make -f ~/linux-util/build_latex/Makefile -C "$(pwd)" clean --no-print-directory
    ;;
    init)
        echo "Initialize a new LaTeX project"
        init
    ;;
    none | *)
        echo "Invalid argument provided. Use the option 'h' for help"
        echo "Exiting..."
        return 1
    ;;
esac
