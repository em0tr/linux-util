#!/bin/bash 

compile() {
    if ! ls *.typ > /dev/null 2>&1; then
        echo "There are no Typst files in the directory. Exiting..."
        exit 1
    fi 
    if [[ ! -f $(pwd)/main.typ ]]; then
        echo "No 'main.typ' file found. The input Typst file must be named 'main.typ'. Exiting..."
        exit 1
    fi 
    typst compile main.typ --font-path fonts/
}

init() {
    if [[ -f "$(pwd)/main.typ" ]]; then
        echo "Directory has been initialized with Typst already"
        exit 1
    fi
    cp ~/util/build_typst/template.typ $(pwd)/main.typ
    cp ~/util/build_typst/template.bib $(pwd)/main.bib
    mkdir -p $(pwd)/figures
    mkdir -p $(pwd)/fonts
    cp ~/util/build_typst/font $(pwd)/font 
}

help() {
    echo "Build Typst files and view PDF files"
    echo ""
    echo "Usage: build-typst {compile|view|init}"
    echo "compile - Compile Typst file(s) to a PDF"
    echo "view    - View the PDF file with Evince"
    echo "init    - Initialize a new Typst project with a template"
    echo "none    - No operation"
    exit 0
}

view() {
    if  [[ ! -f "$(pwd)/main.pdf" ]]; then
        echo "No 'main.pdf' file found. The PDF file must be named 'main.pdf'. Exiting..."
        exit 1
    fi 
    evince "$(pwd)/main.pdf"
}

OPERATION={1:-None}
OPERATION=$(echo "$OPERATION" | tr '[:upper:]' '[:lower:]')
case $OPERATION in 
    compile|build)
        echo "Compile Typst project"
        compile
    ;;
    view)
        echo "Viewing main.pdf file in directory"
        view
    ;;
    help|h)
        help
    ;;
    init|initialize)
        echo "Initialize a new Typst project in $(pwd)"
        init
    ;;
    none|*)
        echo "Invalid argument provided. Use the option 'h' for help"
        exit 1
    ;;
esac
